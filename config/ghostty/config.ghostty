# Ghostty config, translated from config/kitty/kitty.conf (+ gruvbox_dark.conf)
# reload: cmd+shift+, ; docs: ghostty +show-config --default --docs

# fonts (kitty: Hack 14)
font-family = Hack Nerd Font Mono
font-size = 14

# kitty macos_option_as_alt both
macos-option-as-alt = true

# kitty clipboard_control write/read clipboard (OSC 52 from tmux/nvim)
clipboard-read = allow
clipboard-write = allow

# tab bar merged into the titlebar (compact); only applies to new windows
# ("hidden" breaks native tabs: cmd+T opens a new window instead)
# macos-titlebar-style = tabs

# kitty enable_audio_bell no
bell-features = no-audio

# kitty scrollback_lines 10000 -> ghostty counts bytes, ~10 MB default is already generous
# scrollback-limit = 10000000

# ssh to clusters: copy xterm-ghostty terminfo to remote, fall back to xterm-256color
shell-integration-features = ssh-env,ssh-terminfo

# gruvbox dark, identical to kitty gruvbox_dark.conf (differs from ghostty's built-in
# "Gruvbox Dark" in colors 0/7/8/15, cursor and selection)
background = #282828
foreground = #ebdbb2
cursor-color = #928374
cursor-text = #282828
selection-background = #ebdbb2
selection-foreground = #928374

palette = 0=#665c54
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#7c6f64
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#bdae93
