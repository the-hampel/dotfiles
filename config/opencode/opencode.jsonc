{
  "$schema": "https://opencode.ai/config.json",
  "model": "vLLM_spark/Qwen3.6-35B-NVFP4",
  "autoupdate": true,
  "permission": {
    // Edits anywhere in the project dir (and allowed external dirs like /tmp) run without prompts
    "edit": {
      "*": "allow"
    },
    "bash": {
      // Allow everything, like --auto (last matching rule wins, so the
      // destructive rules below still apply)
      "*": "allow",

      // Keep destructive / hard-to-undo commands gated
      "rm *": "ask",
      "rmdir *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "dd *": "ask",
      "mkfs*": "deny"
    },
    "external_directory": {
      // Only /tmp is trusted outside the project dir; everything else still asks
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "omlx_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "http://localhost:8234/v1",
        "apiKey": "gimli2006"
      },
      "models": {
        "Qwopus3.6-27B-v2-MLX-4bit": {
          "name": "Qwen3.6-27B"
        }
      }
    },
    "ollama_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:latest": {
          "name": "qwen3-coder:latest",
          "reasoning": true,
          "tools": true
        }
      }
    },
    "ollama_rtx6000": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (RTX6000)",
      "options": {
        "baseURL": "http://wahoo04.vasp.co:11434/v1"
      },
      "models": {
        "qwen3.6:agent": {
          "name": "Qwen3.6@RTX6000",
          "reasoning": true,
          "tools": true
        }
      }
    },
    "vllm_spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (Spark)",
      "options": {
        "baseURL": "http://10.23.0.111:8000/v1"
      },
      "models": {
        "Qwen3.8-27B-NVFP4": {
          "name": "Qwen3.8-27B-NVFP4",
          "reasoning": true,
          "tools": true
         }
       }
     },
    "ollama_spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Spark)",
      "options": {
        "baseURL": "http://10.23.0.111:11434/v1"
      },
      "models": {
        "qwen3-next:latest": {
          "name": "qwen3-next:opt",
          "reasoning": true,
          "reasoningEffort": "low",
          "tools": true
        },
        "qwen3.6-agent:35b": {
          "name": "Qwen3.6",
